include: "rules/common.smk"


##### Target rules #####


rule all:
    default_target: True
    input:
        expand("results/{sample}/result.tsv", sample=samples),
        expand("results/{sample}/amplicons.fas", sample=samples),


rule prep:
    """
    Create FASTA file for the primers and probes from config
    """
    input:
        tsv="config/primers.tsv",
    output:
        fasta="resources/primers.fas",
    log:
        "logs/prep-primer-fasta.log",
    conda:
        "envs/pandas.yaml"
    script:
        "scripts/prep-primer-fasta.py"


rule prep_yaml:
    """
    Create YAML file for the primers and probes from config
    """
    input:
        tsv="config/primers.tsv",
    output:
        yaml="resources/primers.yaml",
    log:
        "logs/prep-primer-yaml.log",
    conda:
        "envs/pandas.yaml"
    script:
        "scripts/prep-primer-yaml.py"


rule create_dict:
    input:
        "resources/primers.fas",
    output:
        "resources/primers.dict",
    log:
        "logs/picard/create_dict.log",
    resources:
        mem_mb=1024,
    params:
        extra="",  # optional: extra arguments for picard.
    wrapper:
        "v7.6.0/bio/picard/createsequencedictionary"


