ruleorder: get_genome > get_local_genome


rule get_local_genome:
    """
    Copy local genomes to the correct location
    """
    output:
        fasta="resources/genomes/{sample}.fas",
    conda:
        "envs/ncbi-datasets.yaml"
    log:
        "logs/datasets/{sample}.log",
    params:
        local_file=lambda wildcards: local_samples.loc[wildcards.sample, 'assembly_file']
    run:
        import os
        import shutil
        try:
            os.link(local_file, output[0]) 
        except OSError:
            shutil.copy2(local_file, output[0])


rule get_genome:
    """
    Download data from NCBI and place it to correct location
    """
    output:
        fasta="resources/genomes/{sample}.fas",
        zip=temp("resources/datasets/{sample}.zip"),
        dir=temp(directory("resources/datasets/{sample}"))
    conda:
        "envs/ncbi-datasets.yaml"
    log:
        "logs/datasets/{sample}.log",
    params:
        accession=lambda wildcards: accessions.loc[wildcards.sample, 'assembly']
    shell:
        """
        datasets download genome accession {params.accession} --include genome --filename {output.zip}
        unzip {output.dir}.zip -d {output.dir}
        mv {output.dir}/ncbi_dataset/data/{params.accession}/{params.accession}*_genomic.fna {output.fasta}
        """

rule lastdb_transcript:
    input:
        "resources/primers.fas"
    output:
        #"resources/primers.fas.prj"
        "resources/lastaldb.prj"
    params:
        protein_input=False,
        extra="resources/lastaldb"
    log:
        "logs/last/db.log"
    wrapper:
        "v8.0.3/bio/last/lastdb"


rule lastal_nucl_x_nucl:
    input:
        data="resources/genomes/{sample}.fas", # get_genome_fas, # "input/{sample}.fas",
        lastdb="resources/lastaldb.prj"
    output:
        # only one of these outputs is allowed
        maf="results/{sample}/lastal.maf",
        #tab="test-transcript.tab",
        #blasttab="test-transcript.blasttab",
        #blasttabplus="test-transcript.blasttabplus",
    params:
        #Report alignments that are expected by chance at most once per LENGTH query letters. By default, LAST reports alignments that are expected by chance at most once per million query letters (for a given database). http://last.cbrc.jp/doc/last-evalues.html
        D_length=1000000,
        extra=""
    log:
        "logs/last/al-{sample}.log"
    threads: 8
    wrapper:
        "v8.0.3/bio/last/lastal"


rule maf_to_sam:
    input:
        maf="results/{sample}/lastal.maf",
        dict="resources/primers.dict",
    output:
        sam="results/{sample}/lastal.sam"
    conda:
        "envs/primers.yml"
    log:
        "logs/last/maf-to-sam-{sample}.log"
    shell:
        """
        maf-convert sam -f {input.dict} -r 'ID:{wildcards.sample} SM:{wildcards.sample}' {input.maf} > {output.sam} 2> {log}
        """


rule iupacsam:
    input:
        sam="results/{sample}/lastal.sam",
        primers="resources/primers.fas"
    output:
        iupac_sam="results/{sample}/iupac.sam"
    conda:
        "envs/primers.yml"
    log:
        "logs/sam-harmonization/iupac-sam-{sample}.log"
    shell:
        """
        sam-update-iupac.pl {input.sam} {input.primers} > {output.iupac_sam} 2> {log}
        """


rule parse_primers:
    input:
        "results/{sample}/iupac.sam",
        "config/primers.yaml" # "resources/primers.yaml" Could be used instead
    output:
        "results/{sample}/result.tsv"
    conda:
        "envs/primers.yml"
    log:
        "logs/primer-parsing/parse-primers-{sample}.log"
    script:
        "scripts/sam-primers-and-probes.pl"

rule extract_amplicon_regions:
    input:
        tsv="results/{sample}/result.tsv",
    output:
        regions="results/{sample}/regions",
    conda:
        "envs/primers.yml"
    log:
        "logs/extract-amplicons/extract-amplicons-regions-{sample}.log"
    shell:
        """
        cat {input.tsv} | awk -F'\\t' '{{print $2 "\\t" $1}}' | tail -n +2 >{output.regions}
        """


rule extract_amplicon_seqs:
    input:
        "resources/genomes/{sample}.fas", # get_genome_fas, # "input/{sample}.fas"
        regions="results/{sample}/regions",
    output:
        "results/{sample}/amplicons.fas"
    conda:
        "envs/primers.yml"
    params:
       opts=lambda wildcards: f"-tab=results/{wildcards.sample}/regions" #opts=lambda wildcards, input: f"-tab={input.regions}"  
    log:
        "logs/extract-amplicons/extract-amplicons-{sample}.log"
    script:
        "scripts/fasta_get_regions.pl" # {input.fas} -tab={output.regions} > {output.amplicons} 2> {log}

